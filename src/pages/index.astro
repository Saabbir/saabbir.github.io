---
import BaseLayout from '../layouts/BaseLayout.astro';
import tools from '../data/tools.json';

const featuredTools = tools.slice(0, 2);
---
<BaseLayout
  current="home"
  title="Saabbir Hossain — GitHub"
  description="Saabbir Hossain on GitHub: profile, published Pages, and developer tools."
>
  <section class="hero hero-profile">
    <span class="kicker">GitHub profile</span>
    <div class="profile" id="profile">
      <img class="profile-avatar" id="profileAvatar" alt="Saabbir Hossain" width="96" height="96" src="https://github.com/Saabbir.png" />
      <div>
        <h1 id="profileName">Saabbir Hossain</h1>
        <p class="handle">
          <a id="profileHandle" href="https://github.com/Saabbir" target="_blank" rel="noopener noreferrer">@Saabbir</a>
        </p>
        <p class="lede" id="profileBio">Loading profile…</p>
        <div class="profile-meta" id="profileMeta"></div>
        <div class="socials" id="profileSocials"></div>
      </div>
    </div>
    <div class="stat-row">
      <div class="stat"><span class="n" id="statRepos">—</span><span class="l">repositories</span></div>
      <div class="stat"><span class="n" id="statFollowers">—</span><span class="l">followers</span></div>
      <div class="stat"><span class="n" id="statFollowing">—</span><span class="l">following</span></div>
      <div class="stat"><span class="n" id="statStars">—</span><span class="l">stars</span></div>
    </div>
  </section>

  <div class="charts" id="charts">
    <div class="chart-card">
      <h2>Top languages</h2>
      <div id="langChart"><div class="skeleton" style="height: 160px"></div></div>
    </div>
    <div class="chart-card">
      <h2>Most starred</h2>
      <div id="starChart"><div class="skeleton" style="height: 160px"></div></div>
    </div>
  </div>

  <div class="section-head">
    <h2>Tools</h2>
    <a class="more-link" href="/tools/">All tools</a>
  </div>
  <div class="tool-grid">
    {featuredTools.map((tool) => (
      <a
        class="tool-card"
        href={tool.url}
        target={tool.external ? '_blank' : undefined}
        rel={tool.external ? 'noopener noreferrer' : undefined}
      >
        <h3>{tool.title}</h3>
        <p>{tool.blurb}</p>
        <span class="tags">{tool.tags.join(' · ')}</span>
      </a>
    ))}
  </div>

  <div class="section-head">
    <h2>Latest Pages</h2>
    <a class="more-link" href="/pages/">All pages</a>
  </div>
  <div class="projects" id="projects">
    <div class="skeleton"></div>
    <div class="skeleton"></div>
    <div class="skeleton"></div>
  </div>
</BaseLayout>

<script>
  import { loadProfileAndRepos, isPagesProject, toProject, languageCounts, totalStars, topStarredRepos } from '../lib/github.js';
  import { escapeHtml, formatJoin, renderProjectGrid, stateCard, quotaCard, donutHTML, barsHTML } from '../lib/render.js';

  function initHome() {
    const projectsEl = document.getElementById('projects');
    if (!document.getElementById('profile') || !projectsEl) return;

    function paintProfile(profile, repos) {
      if (!profile) return;
      const avatar = document.getElementById('profileAvatar');
      avatar.src = profile.avatar_url;
      avatar.alt = profile.name || profile.login;

      document.getElementById('profileName').textContent = profile.name || profile.login;
      const handle = document.getElementById('profileHandle');
      handle.href = profile.html_url;
      handle.textContent = '@' + profile.login;

      document.getElementById('profileBio').textContent = profile.bio || '';

      const bits = [];
      if (profile.company) bits.push('<span>' + escapeHtml(profile.company) + '</span>');
      if (profile.location) bits.push('<span>' + escapeHtml(profile.location) + '</span>');
      bits.push('<span>' + escapeHtml(formatJoin(profile.created_at)) + '</span>');
      document.getElementById('profileMeta').innerHTML = bits.join('');

      const socials = [];
      socials.push(
        '<a href="' + escapeHtml(profile.html_url) + '" target="_blank" rel="noopener noreferrer">GitHub</a>'
      );
      socials.push(
        '<a href="https://saabbir.com" target="_blank" rel="noopener noreferrer">Website</a>'
      );
      if (profile.twitter_username) {
        socials.push(
          '<a href="https://x.com/' +
            encodeURIComponent(profile.twitter_username) +
            '" target="_blank" rel="noopener noreferrer">@' +
            escapeHtml(profile.twitter_username) +
            '</a>'
        );
      }
      document.getElementById('profileSocials').innerHTML = socials.join('');

      document.getElementById('statRepos').textContent = String(profile.public_repos ?? '—');
      document.getElementById('statFollowers').textContent = String(profile.followers ?? '—');
      document.getElementById('statFollowing').textContent = String(profile.following ?? '—');
      document.getElementById('statStars').textContent = String(totalStars(repos || []));

      const langs = languageCounts(repos || []);
      document.getElementById('langChart').innerHTML = langs.length
        ? donutHTML(langs)
        : '<p class="note">No language data yet.</p>';
      const starred = topStarredRepos(repos || [], 6);
      document.getElementById('starChart').innerHTML = starred.length
        ? barsHTML(starred)
        : '<p class="note">No starred repos yet.</p>';
    }

    function paintPages(repos, instant) {
      const projects = (repos || []).filter(isPagesProject).map(toProject);
      projects.sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));
      renderProjectGrid(projectsEl, projects.slice(0, 6), instant);
    }

    loadProfileAndRepos()
      .then(({ profile, repos }) => {
        paintProfile(profile, repos);
        paintPages(repos, true);
      })
      .catch((err) => {
        const cached = err.cached;
        if (cached && cached.profile) {
          paintProfile(cached.profile, cached.repos);
          paintPages(cached.repos, true);
        } else if (err.rateLimited) {
          projectsEl.innerHTML = quotaCard(err);
        } else {
          projectsEl.innerHTML = stateCard("Couldn't load", 'Try again after the GitHub API reset.');
        }
      });
  }

  document.addEventListener('astro:page-load', initHome);
</script>
