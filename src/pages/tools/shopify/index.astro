---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  current="tools"
  title="Shopify on GitHub — saabbir.github.io"
  description="Shopify theme developers, app developers, and notable GitHub activity."
>
  <section class="hero">
    <span class="kicker">Shopify radar</span>
    <h1>Shopify on <em>GitHub</em></h1>
    <p class="lede">
      Theme developers, app developers, and the repos they ship. Official Shopify activity is listed below as one-line highlights.
    </p>
  </section>

  <div class="section-head">
    <h2>Today’s highlights</h2>
    <span class="count" id="feedCount">10–20</span>
  </div>
  <p class="note">Releases, new repos, and pull requests first. Quiet days fill in with other public activity.</p>
  <div class="feed" id="feed">
    <div class="skeleton" style="height: 48px"></div>
  </div>

  <div class="section-head">
    <h2>Theme developers</h2>
    <span class="count" id="themeCount"></span>
  </div>
  <p class="note">People with at least one Shopify theme repository.</p>
  <div class="person-grid" id="themePeople">
    <div class="skeleton"></div>
  </div>

  <div class="section-head">
    <h2>App developers</h2>
    <span class="count" id="appCount"></span>
  </div>
  <p class="note">People with at least one Shopify app repository.</p>
  <div class="person-grid" id="appPeople">
    <div class="skeleton"></div>
  </div>

  <div class="section-head">
    <h2>Repos</h2>
    <span class="count" id="repoCount"></span>
  </div>
  <div class="filter-chips" id="filters">
    <button type="button" data-kind="all" class="active">All</button>
    <button type="button" data-kind="theme">Theme</button>
    <button type="button" data-kind="app">App</button>
    <button type="button" data-kind="toolkit">Toolkit</button>
    <button type="button" data-kind="ai">AI</button>
  </div>
  <div class="repo-list" id="repos">
    <div class="skeleton" style="height: 72px"></div>
  </div>
</BaseLayout>

<script>
  import { loadShopifyRadar, loadShopifyFeed, REPOS_CAP, personPlace } from '../../../lib/shopify.js';
  import { escapeHtml, quotaCard, stateCard } from '../../../lib/render.js';
  import { refreshRateLimit } from '../../../lib/github.js';

  function feedHTML(feed) {
    const items = (feed && feed.items) || [];
    const highlights = (feed && feed.highlights) || [];
    const highlightKeys = {};
    highlights.forEach((item) => { highlightKeys[item.key] = true; });
    if (!items.length) {
      return stateCard('Quiet stretch', 'No public Shopify org activity to show right now.');
    }
    const count = document.getElementById('feedCount');
    if (count) count.textContent = String(items.length);
    return items
      .map((item) => {
        const cls = highlightKeys[item.key] ? 'highlight' : 'quiet';
        return (
          '<a class="' +
          cls +
          '" href="' +
          escapeHtml(item.url) +
          '" target="_blank" rel="noopener noreferrer">' +
          escapeHtml(item.text) +
          '</a>'
        );
      })
      .join('');
  }

  function peopleHTML(people, empty) {
    if (!people.length) return stateCard('None yet', empty);
    return people
      .map((p) => {
        const place = personPlace(p);
        const meta = ['@' + p.login];
        if (p.followers != null) meta.push(p.followers + ' followers');
        meta.push((p.stars || 0) + '★');
        let badge = '';
        if (place.flag) {
          const tip = place.label || 'Location';
          badge =
            '<span class="flag-badge" data-tooltip="' +
            escapeHtml(tip) +
            '" aria-label="' +
            escapeHtml(tip) +
            '">' +
            place.flag +
            '</span>';
        } else if (place.label) {
          badge =
            '<span class="location-badge" title="' +
            escapeHtml(place.label) +
            '">' +
            escapeHtml(place.label) +
            '</span>';
        }
        const display = p.name ? escapeHtml(p.name) : escapeHtml(p.login);
        return (
          '<a class="person-card" href="' + escapeHtml(p.htmlUrl) + '" target="_blank" rel="noopener noreferrer">' +
          badge +
          '<img src="' + escapeHtml(p.avatar) + '" alt="" width="44" height="44" />' +
          '<div><strong>' + display + '</strong>' +
          '<span>' + escapeHtml(meta.join(' · ')) + '</span></div></a>'
        );
      })
      .join('');
  }

  function initShopify() {
    const feedEl = document.getElementById('feed');
    const reposEl = document.getElementById('repos');
    const filters = document.getElementById('filters');
    if (!feedEl || !reposEl || !filters) return;

    let allRepos = [];
    let kind = 'all';

    function paintRepos() {
      const filtered = allRepos.filter((r) => (kind === 'all' ? true : r.kind === kind)).slice(0, REPOS_CAP);
      document.getElementById('repoCount').textContent = String(filtered.length);
      if (!filtered.length) {
        reposEl.innerHTML = stateCard('No repos', 'Nothing in this filter for the current snapshot.');
        return;
      }
      reposEl.innerHTML = filtered
        .map((r) => {
          const desc = r.description ? escapeHtml(r.description) : '';
          return (
            '<a class="repo-row" href="' + escapeHtml(r.html_url) + '" target="_blank" rel="noopener noreferrer">' +
            '<div><strong>' + escapeHtml(r.full_name) + '</strong>' +
            '<span class="repo-meta">' + (r.stargazers_count || 0) + '★ · ' + escapeHtml(r.kind) + '</span>' +
            (desc ? '<span class="repo-desc">' + desc + '</span>' : '') +
            '</div></a>'
          );
        })
        .join('');
    }

    filters.addEventListener('click', (event) => {
      const btn = event.target.closest('button[data-kind]');
      if (!btn) return;
      kind = btn.getAttribute('data-kind');
      filters.querySelectorAll('button').forEach((el) => el.classList.toggle('active', el === btn));
      paintRepos();
    });

    refreshRateLimit().finally(() => {
      loadShopifyFeed()
        .then((feed) => {
          feedEl.innerHTML = feedHTML(feed);
        })
        .catch((err) => {
          feedEl.innerHTML = err.rateLimited ? quotaCard(err) : stateCard("Couldn't load highlights", 'Try again after the API reset.');
        });

      loadShopifyRadar()
        .then((data) => {
          const theme = (data.people && data.people.theme) || [];
          const app = (data.people && data.people.app) || [];
          document.getElementById('themeCount').textContent = String(theme.length);
          document.getElementById('appCount').textContent = String(app.length);
          document.getElementById('themePeople').innerHTML = peopleHTML(
            theme,
            'No theme developers in this snapshot.'
          );
          document.getElementById('appPeople').innerHTML = peopleHTML(
            app,
            'No app developers in this snapshot.'
          );
          allRepos = data.repos || [];
          paintRepos();
        })
        .catch((err) => {
          document.getElementById('themePeople').innerHTML = err.rateLimited
            ? quotaCard(err)
            : stateCard("Couldn't load people", 'GitHub search quota may be empty.');
          document.getElementById('appPeople').innerHTML = '';
          reposEl.innerHTML = '';
        });
    });
  }

  document.addEventListener('astro:page-load', initShopify);
</script>

